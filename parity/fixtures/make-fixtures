def full_creds() -> str:
    # Real /login credential shape; expiresAt 8h out so nothing refreshes.
    return (
        '{"claudeAiOauth": {"accessToken": "{{tok:full_at}}", '
        '"refreshToken": "{{tok:full_rt}}", "expiresAt": {{ms:+28800}}, '
        '"scopes": ["user:inference", "user:profile", "user:sessions:claude_code"], '
        '"subscriptionType": "max"}}'
    )


def setup_creds(tok: str) -> str:
    # Exactly what `cswap add-token` stores (switcher.py add_account_from_token).
    return '{"claudeAiOauth": {"accessToken": "{{tok:%s}}", "scopes": ["user:inference"]}}' % tok


def owner_oauth_account() -> dict:
    return {
        "accountUuid": OWNER["uuid"],
        "emailAddress": OWNER["email"],
        "organizationUuid": OWNER["org"],
        "organizationName": OWNER["orgName"],
        "displayName": "Owner",
        "organizationRole": "admin",
    }


def claude_json(oauth: dict | None) -> str:
    doc = {"numStartups": 42, "theme": "dark", "hasCompletedOnboarding": True}
    if oauth is not None:
        doc["oauthAccount"] = oauth
    return json.dumps(doc, indent=2)


def setup_config(email: str) -> str:
    return json.dumps({"oauthAccount": {"emailAddress": email, "accountUuid": "",
                                        "organizationUuid": None, "organizationName": None}})


def six_accounts(active: int = 1, slots=range(1, 7), disabled=()) -> dict[str, str]:
    """home/ files for the production-shaped world: slot 1 = full login,
    slots 2-6 = setup-tokens. `active` is the live login (None = logged out)."""
    files: dict[str, str] = {}
    seq = {"activeAccountNumber": active, "lastUpdated": "{{isoz:-86400}}",
           "sequence": list(slots), "accounts": {}}
    for n in slots:
        if n == 1:
            rec = {"email": OWNER["email"], "uuid": OWNER["uuid"],
                   "organizationUuid": OWNER["org"], "organizationName": OWNER["orgName"],
                   "added": "{{isoz:-864000}}"}
            files[f"{BK}/credentials/.creds-1-{OWNER['email']}.enc.b64src"] = full_creds()
            files[f"{BK}/configs/.claude-config-1-{OWNER['email']}.json"] = claude_json(owner_oauth_account())
        else:
            email = SETUP[n]
            rec = {"email": email, "uuid": "", "organizationUuid": "", "organizationName": "",
                   "added": "{{isoz:-864000}}"}
            files[f"{BK}/credentials/.creds-{n}-{email}.enc.b64src"] = setup_creds(f"st{n}")
            files[f"{BK}/configs/.claude-config-{n}-{email}.json"] = setup_config(email)
        if n in disabled:
            rec["disabled"] = True
        seq["accounts"][str(n)] = rec
    files[f"{BK}/sequence.json"] = json.dumps(seq, indent=2)
    if active == 1:
        files[".claude/.credentials.json"] = full_creds()
        files[".claude.json"] = claude_json(owner_oauth_account())
    elif active is not None:
        files[".claude/.credentials.json"] = setup_creds(f"st{active}")
        files[".claude.json"] = claude_json(json.loads(setup_config(SETUP[active]))["oauthAccount"])
    return files


def window(pct, reset_s):
    return {"pct": pct, "resets_at": "{{iso:+%d}}" % reset_s, "countdown": "seed", "clock": "seed"}


def usage_row(n: int, five: float, seven: float, *, age=30, scoped=None, next_poll=150,
              interval=180.0, **extra) -> dict:
    email = OWNER["email"] if n == 1 else SETUP[n]
    org = OWNER["org"] if n == 1 else ""
    last_good = {"five_hour": window(five, 7200), "seven_day": window(seven, 259200)}
    if scoped:
        last_good["scoped"] = [dict(window(p, 259200), name=name) for name, p in scoped.items()]
    row = {"email": email, "organizationUuid": org, "lastGood": last_good,
           "fetchedAt": "{{epoch:-%d}}" % age, "lastAttemptAt": "{{epoch:-%d}}" % age,
           "claimId": None, "claimUntil": 0.0, "consecutiveFailures": 0, "lastError": None,
           "backoffUntil": None, "nextPollAt": "{{epoch:+%d}}" % next_poll,
           "pollIntervalS": interval, "authDeadStrikes": 0}
    row.update(extra)
    return row


def usage_cache(rows: dict[int, dict]) -> dict[str, str]:
    # "{{epoch:N}}" strings become numbers when the replay seeds a .json file.
    doc = {"schemaVersion": 2, "accounts": {str(n): r for n, r in rows.items()}}
    return {f"{BK}/cache/usage.json": json.dumps(doc, indent=2)}


def settings(**autoswitch) -> dict[str, str]:
    return {f"{BK}/settings.json": json.dumps({"schemaVersion": 1, "autoswitch": autoswitch}, indent=2)}


