# ------------------------------------------------------------------ write

def main() -> None:
    for old in ROOT.iterdir():
        if old.is_dir() and (old / "fixture.json").exists() and old.name not in FIXTURES:
            shutil.rmtree(old)
    for name, fx in FIXTURES.items():
        d = ROOT / name
        if (d / "home").exists():
            shutil.rmtree(d / "home")
        d.mkdir(exist_ok=True)
        home = fx.pop("_home")
        for rel, text in home.items():
            p = d / "home" / rel
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(text)
        if not home:
            (d / "home").mkdir(exist_ok=True)
            (d / "home" / ".keep").write_text("")
        (d / "fixture.json").write_text(json.dumps(fx, indent=2) + "\n")
    print(f"wrote {len(FIXTURES)} fixtures")


if __name__ == "__main__":
    main()
