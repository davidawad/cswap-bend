def probe(tok: str, five: float, seven: float, status=200, five_reset=3600, seven_reset=259200,
          extra_headers=None) -> dict:
    """Patched-0003 setup-token usage read: 1-token haiku POST /v1/messages."""
    headers = {
        "anthropic-ratelimit-unified-5h-utilization": str(five),
        "anthropic-ratelimit-unified-5h-reset": "{{epoch:+%d}}" % five_reset,
        "anthropic-ratelimit-unified-7d-utilization": str(seven),
        "anthropic-ratelimit-unified-7d-reset": "{{epoch:+%d}}" % seven_reset,
    }
    headers.update(extra_headers or {})
    body = ({"id": "msg_FAKE", "type": "message", "role": "assistant", "model": "claude-haiku-5-5",
             "content": [{"type": "text", "text": "."}], "stop_reason": "max_tokens",
             "usage": {"input_tokens": 20, "output_tokens": 1}}
            if status == 200 else
            {"type": "error", "error": {"type": "rate_limit_error", "message": "rate limited"}})
    return {"method": "POST", "url": f"{ANTHROPIC}/v1/messages", "auth": tok,
            "status": status, "headers": headers, "body": body}


def probe_fail(tok: str, status: int, retry_after=None) -> dict:
    headers = {"retry-after": str(retry_after)} if retry_after is not None else {}
    return {"method": "POST", "url": f"{ANTHROPIC}/v1/messages", "auth": tok, "status": status,
            "headers": headers,
            "body": {"type": "error", "error": {"type": "rate_limit_error", "message": "FAKE"}}}


def usage_endpoint(tok="full_at", five=12.0, seven=40.0, scoped=None, status=200, retry_after=None):
    if status != 200:
        headers = {"retry-after": str(retry_after)} if retry_after is not None else {}
        return {"method": "GET", "url": f"{ANTHROPIC}/api/oauth/usage", "auth": tok,
                "status": status, "headers": headers,
                "body": {"type": "error", "error": {"type": "error", "message": "FAKE"}}}
    body = {"five_hour": {"utilization": five, "resets_at": "{{iso:+5400}}"},
            "seven_day": {"utilization": seven, "resets_at": "{{iso:+259200}}"},
            "extra_usage": {"is_enabled": False}}
    if scoped:
        body["limits"] = [{"percent": p, "resets_at": "{{iso:+259200}}",
                           "scope": {"model": {"display_name": name}}} for name, p in scoped.items()]
    return {"method": "GET", "url": f"{ANTHROPIC}/api/oauth/usage", "auth": tok, "body": body}


def profile(tok="full_at"):
    return {"method": "GET", "url": f"{ANTHROPIC}/api/oauth/profile", "auth": tok,
            "body": {"account": {"uuid": OWNER["uuid"], "email": OWNER["email"]},
                     "organization": {"uuid": OWNER["org"]}}}


def profile_scope_denied(tok: str):
    """A setup-token (user:inference only) asking the profile oracle."""
    return {"method": "GET", "url": f"{ANTHROPIC}/api/oauth/profile", "auth": tok, "status": 403,
            "body": {"type": "error", "error": {"type": "permission_error",
                                                "message": "OAuth token does not meet scope requirement user:profile"}}}


def all_probes(**pcts):
    return [probe(f"st{n}", *pcts.get(f"st{n}", (0.1, 0.2))) for n in range(2, 7)]


