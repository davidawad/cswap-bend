+SETUP_TOKEN_PROBE_MODEL = "claude-haiku-5-5"
+_RL = "anthropic-ratelimit-unified-"
+
+# Fingerprints of access tokens the usage endpoint refused for scope
+# (setup-tokens are user:inference only). Those go straight to the
+# inference-header probe instead of spending a 403 every poll.
+_inference_only_tokens: set[str] = set()
+
+
+def _token_key(access_token: str) -> str:
+    return hashlib.sha256(access_token.encode()).hexdigest()
+
+
+def _is_scope_error(e: urllib.error.HTTPError) -> bool:
+    if e.code != 403:
+        return False
+    try:
+        body = e.read().decode(errors="replace")
+    except Exception:
+        return False
+    return "oauth_scope_insufficient" in body or "scope requirement" in body
+
+
+def usage_from_ratelimit_headers(headers) -> dict | None:
+    """Map ``anthropic-ratelimit-unified-*`` response headers to the
+    /api/oauth/usage shape (utilization 0-100, ISO ``resets_at``)."""
+
+    def window(prefix: str) -> dict | None:
+        util = headers.get(f"{_RL}{prefix}-utilization")
+        if util is None:
+            return None
+        entry: dict = {"utilization": round(float(util) * 100, 1)}
+        reset = headers.get(f"{_RL}{prefix}-reset")
+        if reset:
+            entry["resets_at"] = datetime.fromtimestamp(
+                int(reset), tz=timezone.utc
+            ).isoformat()
+        return entry
+
+    data = {k: w for k, w in (("five_hour", window("5h")), ("seven_day", window("7d"))) if w}
+    return data or None
+
+
+def request_usage_via_inference(access_token: str) -> dict:
+    """Usage for an inference-only (setup-token) credential: a 1-token
+    Messages call whose rate-limit headers carry the same 5h/7d utilization
+    the usage endpoint reports. An exhausted account answers 429 but still
+    sends the headers, which is a valid reading."""
+    body = json.dumps({
+        "model": SETUP_TOKEN_PROBE_MODEL,
+        "max_tokens": 1,
+        "system": [{"type": "text", "text": "You are Claude Code, Anthropic's official CLI for Claude."}],
+        "messages": [{"role": "user", "content": "."}],
+    }).encode()
+    req = urllib.request.Request(
+        "https://api.anthropic.com/v1/messages",
+        data=body,
+        headers={
+            "Authorization": f"Bearer {access_token}",
+            "anthropic-version": "2023-06-01",
+            "anthropic-beta": f"claude-code-20250219,{OAUTH_BETA_HEADER}",
+            "content-type": "application/json",
+            "User-Agent": "claude-swap/1.0",
+        },
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=20) as resp:
+            data = usage_from_ratelimit_headers(resp.headers)
+    except urllib.error.HTTPError as e:
+        data = usage_from_ratelimit_headers(e.headers) if e.headers else None
+        if data is None:
+            raise
+    if data is None:
+        raise json.JSONDecodeError("no ratelimit headers", "", 0)
+    return data
+
