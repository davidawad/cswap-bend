import Base
import ./src/http.bend as Http
import ./src/policy/types.bend as T
import ./src/policy/usage.bend as U
import ./src/policy/decide.bend as D
import ./src/policy/spec.bend as S
import ./src/policy/safe.bend as SF
import ./src/policy/algo.bend as A
import ./src/policy/specalg.bend as SA

# Human-written claims. Agents do not edit this file; PROOF.bend proves each
# law with a def of the same name. The decision-core laws (switch only to a
# trusted reading, never fail over on unknown headroom, pick the max-headroom
# or soonest-recovery account) are the `decide_*` and `poll_due_*` laws below.

# A header search over no lines finds nothing, whatever the name.
law header_none_on_empty:
  for +name: String
  {Http.header.find(name, Nil{}, None{}) == None{} : Maybe<&2, String>}

# Once a header is found, the remaining lines are never consulted.
law header_found_sticks:
  for +name: String
  for ls: List<&2, String>
  for +v: String
  {Http.header.find(name, ls, Some{v}) == Some{v} : Maybe<&2, String>}

# --- the decision core (src/policy/types.bend, src/policy/usage.bend, src/policy/decide.bend,
# src/policy/spec.bend), decision core
#
# `decide` is one autoswitch tick of claude_swap 0.27.2 with patch 0002:
# strategy best or consume-first, every trigger, the idle hold and failover,
# the no-return bar and recovery mode. The predicates the laws use are in
# src/policy/spec.bend.

# 1. A switch lands on an account with a trusted reading, exactly as the
# reference trusts one (fresh, or extended while the row is failing, planned,
# held or claimed). Backoff only throttles polling the usage endpoint, so a
# candidate in backoff with a still-trusted reading stays eligible. The one
# other kind of target is the last-resort API-key account, and only with the
# include flag.
law decide_switch_trusted:
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for +st: T.State
  for +mem: T.Mem
  {S.landed_trusted(D.decide(active, accounts, usage, now, cfg, st, mem), accounts, active, usage, now, cfg) == True{} : Bool}

# 2. Unknown active headroom never switches, unless the tick reaches the
# failover trigger: the active token is the expired-token sentinel, the idle
# hold of 30 minutes has run out and the unhealthy ticks have reached the
# limit (patch 0002: every other unknown never counts toward failover). With
# a fresh process (`--once`) the trigger is unreachable.
law decide_unknown_no_switch_unless_failover:
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for +st: T.State
  for +mem: T.Mem
  for unknown: {U.head.row(U.usage.of(active, usage), now, D.cfg.models(cfg)) == None{} : Maybe<&2, Nat>}
  for no_failover: {S.failover_ready(active, usage, now, cfg, mem) == False{} : Bool}
  {S.is_switch(D.decide(active, accounts, usage, now, cfg, st, mem)) == False{} : Bool}

# 3. In headroom mode (strategy best outside recovery mode, and at-limit and
# failover) the target is an account whose eligible headroom is the stated one,
# and no eligible account has strictly more. Eligible: OAuth, enabled, not the
# live slot, not the barred account, a trusted reading with headroom above
# zero. (The hysteresis and landing gates only narrow the choice, so they
# cannot admit anyone above the winner.) Recovery mode and consume-first rank
# by recovery or weekly reset, not headroom: they are out of scope here.
law decide_switch_best_headroom:
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for +st: T.State
  for +mem: T.Mem
  {S.landed_best(D.decide(active, accounts, usage, now, cfg, st, mem), accounts, active, usage, now, cfg) == True{} : Bool}

# 3b. In recovery mode (the active account and every measured candidate are at
# or over the threshold, proactive trigger) a back-soon target has the
# earliest recovery of the candidates that qualify as back-soon, and is one of
# them.
law decide_recovery_earliest:
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for +st: T.State
  for +mem: T.Mem
  {S.landed_rec(D.decide(active, accounts, usage, now, cfg, st, mem), accounts, active, usage, now, cfg) == True{} : Bool}

# 4. decide never returns Switch to the active slot.
law decide_switch_not_active:
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for +st: T.State
  for +mem: T.Mem
  {S.not_active(D.decide(active, accounts, usage, now, cfg, st, mem), active) == True{} : Bool}

# 5. poll_due is False whenever now < backoff_until.
law poll_due_backoff:
  for +u: T.Usage
  for +now: Nat
  for +cfg: T.Config
  for inside: {Nat.is_lt(now, U.usage.backoff_until(u)) == True{} : Bool}
  {U.poll_due(u, now, cfg) == False{} : Bool}

# --- behaviour profiles (src/policy/safe.bend, src/policy/algo.bend,
# src/policy/specalg.bend), behaviour profiles
#
# A profile picks one of five strategies: best, round-robin, soonest-reset,
# sticky, drain-first. `best` is the reference engine `D.decide`, unchanged.
# The other four share one candidate picker; a strategy only changes the
# ranking key, never who may be chosen. A candidate is "safe" when it is an
# OAuth account, enabled, not the live slot, with a trusted headroom above
# zero, and not in backoff. `A.decide` is one automatic tick under a strategy;
# `A.rotate` is the manual `switch` with no target (it skips the threshold and
# the cooldown). Neither switches away from an account whose headroom is
# unknown: that is what `cswap switch NUM` is for.
#
# `best` keeps its own, looser eligibility so that it stays byte-identical to
# the reference: a candidate in backoff with a still-trusted reading stays
# eligible, and an API-key account can be the last resort. So the claims about
# the target being safe are for the four strategies that use the picker
# (`SF.strict(algo)`); the claims about the live slot and about an unknown
# active headroom cover every strategy.

# P1. A safe account is not the live slot.
law profile_safe_not_active:
  for +a: T.Account
  for +active: Nat
  for +us: List<&2, T.Usage>
  for +now: Nat
  for +ms: List<&2, String>
  for safe: {SF.safe(a, active, us, now, ms) == True{} : Bool}
  {Nat.is_eq(U.account.slot(a), active) == False{} : Bool}

# P2. A safe account has a trusted reading with a headroom.
law profile_safe_known:
  for +a: T.Account
  for +active: Nat
  for +us: List<&2, T.Usage>
  for +now: Nat
  for +ms: List<&2, String>
  for safe: {SF.safe(a, active, us, now, ms) == True{} : Bool}
  {SF.known(U.head.row(U.usage.of(U.account.slot(a), us), now, ms)) == True{} : Bool}

# P3. A safe account is not exhausted (its headroom is not zero).
law profile_safe_not_exhausted:
  for +a: T.Account
  for +active: Nat
  for +us: List<&2, T.Usage>
  for +now: Nat
  for +ms: List<&2, String>
  for safe: {SF.safe(a, active, us, now, ms) == True{} : Bool}
  {SF.exhausted(U.head.row(U.usage.of(U.account.slot(a), us), now, ms)) == False{} : Bool}

# P4. A safe account is not in backoff.
law profile_safe_not_backoff:
  for +a: T.Account
  for +active: Nat
  for +us: List<&2, T.Usage>
  for +now: Nat
  for +ms: List<&2, String>
  for safe: {SF.safe(a, active, us, now, ms) == True{} : Bool}
  {SF.backed_off(U.usage.of(U.account.slot(a), us), now) == False{} : Bool}

# P5. An automatic tick under round-robin, soonest-reset, sticky or
# drain-first switches only to a safe account: so never to one in backoff, one
# with no trusted reading, or an exhausted one.
law profile_switch_target_safe:
  for +algo: SF.Algo
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for +st: T.State
  for +mem: T.Mem
  for strict: {SF.strict(algo) == True{} : Bool}
  {SA.landed_ok(A.decide(algo, active, accounts, usage, now, cfg, st, mem), accounts, active, usage, now, D.cfg.models(cfg)) == True{} : Bool}

# P6. No strategy's automatic tick switches to the active slot.
law profile_switch_not_active:
  for +algo: SF.Algo
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for +st: T.State
  for +mem: T.Mem
  {S.not_active(A.decide(algo, active, accounts, usage, now, cfg, st, mem), active) == True{} : Bool}

# P7. No strategy's automatic tick switches while the active headroom is
# unknown, unless it is `best` reaching its failover trigger (law 2 above).
law profile_unknown_no_switch:
  for +algo: SF.Algo
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for +st: T.State
  for +mem: T.Mem
  for unknown: {U.head.row(U.usage.of(active, usage), now, D.cfg.models(cfg)) == None{} : Maybe<&2, Nat>}
  for no_failover: {S.failover_ready(active, usage, now, cfg, mem) == False{} : Bool}
  {S.is_switch(A.decide(algo, active, accounts, usage, now, cfg, st, mem)) == False{} : Bool}

# P8. A manual rotation under any strategy switches only to a safe account.
law profile_rotate_target_safe:
  for +algo: SF.Algo
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  {SA.landed_ok(A.rotate(algo, active, accounts, usage, now, cfg), accounts, active, usage, now, D.cfg.models(cfg)) == True{} : Bool}

# P9. A manual rotation never lands on the active slot.
law profile_rotate_not_active:
  for +algo: SF.Algo
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  {S.not_active(A.rotate(algo, active, accounts, usage, now, cfg), active) == True{} : Bool}

# P10. A manual rotation never switches while the active headroom is unknown.
law profile_rotate_unknown_no_switch:
  for +algo: SF.Algo
  for +active: Nat
  for +accounts: List<&2, T.Account>
  for +usage: List<&2, T.Usage>
  for +now: Nat
  for +cfg: T.Config
  for unknown: {U.head.row(U.usage.of(active, usage), now, D.cfg.models(cfg)) == None{} : Maybe<&2, Nat>}
  {S.is_switch(A.rotate(algo, active, accounts, usage, now, cfg)) == False{} : Bool}
