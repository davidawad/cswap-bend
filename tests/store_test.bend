def prof_body() -> String:
  "{\"account\": {\"uuid\": \"u1\", \"email\": \"a@example.test\"}, \"organization\": {\"uuid\": \"o1\"}}"

def o_parse() -> {SPlan.profile_of_text(prof_body()) == SPlan.Prof{"u1", Some{"a@example.test"}, Some{"o1"}} : SPlan.Prof}:
  {==}

def o_no_org_block() -> {SPlan.profile_of_text("{\"account\": {\"uuid\": \"u1\"}}") == SPlan.Prof{"u1", None{}, None{}} : SPlan.Prof}:
  {==}

def o_no_uuid() -> {SPlan.profile_of_text("{\"account\": {\"email\": \"a@b.test\"}}") == SPlan.ProfNone{} : SPlan.Prof}:
  {==}

def o_no_account() -> {SPlan.profile_of_text("{\"error\": \"x\"}") == SPlan.ProfNone{} : SPlan.Prof}:
  {==}

def o_garbage() -> {SPlan.profile_of_text("<html>") == SPlan.ProfNone{} : SPlan.Prof}:
  {==}

def j_match_uuid() -> {SPlan.judge("a@example.test", "o1", "u1", SPlan.profile_of_text(prof_body())) == SPlan.VOk{} : SPlan.Verdict}:
  {==}

def j_match_email_when_no_uuid() -> {SPlan.judge("A@Example.test", "o1", "", SPlan.profile_of_text(prof_body())) == SPlan.VOk{} : SPlan.Verdict}:
  {==}

def j_other_uuid() -> {SPlan.judge("a@example.test", "o1", "u9", SPlan.profile_of_text(prof_body())) == SPlan.VBad{SPlan.bad_uuid("a@example.test", "u1", "u9")} : SPlan.Verdict}:
  {==}

def j_other_email() -> {SPlan.judge("c@example.test", "o1", "", SPlan.profile_of_text(prof_body())) == SPlan.VBad{SPlan.bad_email("c@example.test", "a@example.test")} : SPlan.Verdict}:
  {==}

def j_other_org() -> {SPlan.judge("a@example.test", "o2", "u1", SPlan.profile_of_text(prof_body())) == SPlan.VBad{SPlan.bad_org("a@example.test", "o1", "o2")} : SPlan.Verdict}:
  {==}

def j_personal_vs_org() -> {SPlan.judge("a@example.test", "", "u1", SPlan.profile_of_text(prof_body())) == SPlan.VBad{SPlan.bad_org("a@example.test", "o1", "")} : SPlan.Verdict}:
  {==}

def j_absent_org_is_unverifiable_not_wrong() -> {SPlan.judge("a@example.test", "o9", "u1", SPlan.profile_of_text("{\"account\": {\"uuid\": \"u1\"}}")) == SPlan.VOk{} : SPlan.Verdict}:
  {==}

def j_unresolved() -> {SPlan.judge("a@example.test", "o1", "u1", SPlan.ProfNone{}) == SPlan.VUnverified{"the identity lookup did not resolve"} : SPlan.Verdict}:
  {==}

def j_no_address() -> {SPlan.judge("a@example.test", "o1", "", SPlan.profile_of_text("{\"account\": {\"uuid\": \"u1\"}}")) == SPlan.VUnverified{"the resolved identity carries no address"} : SPlan.Verdict}:
  {==}

def j_bad_uuid_message() -> {SPlan.bad_uuid("a@b.test", "u1", "u9") == "The stored credential does not belong to a@b.test: the token resolves to account u1, not u9. Nothing was changed. This happens when the config names one account while the credential store still holds another's token (e.g. a renamed .claude.json over a live keychain item). Log in as a@b.test in THIS environment, then re-run." : String}:
  {==}

def j_bad_org_message() -> {SPlan.bad_org("a@b.test", "", "o2") == "The stored credential for a@b.test belongs to organization personal, not o2. Nothing was changed. Two accounts can share an email across organizations. Log in as a@b.test in the o2 organization in THIS environment, then re-run." : String}:
  {==}

def plan_live(exp: String) -> SPlan.Plan:
  SPlan.plan_for("{\"claudeAiOauth\": {\"accessToken\": \"tok\", \"expiresAt\": " ++ exp ++ "}}", 1000)

def pl_fetch() -> {plan_live("2000000") == SPlan.PFetch{"tok"} : SPlan.Plan}:
  {==}

def pl_expired() -> {plan_live("999000") == SPlan.PSkip{"the access token is expired"} : SPlan.Plan}:
  {==}

def pl_far_future_ms_overflows_u32() -> {plan_live("9999999999999") == SPlan.PFetch{"tok"} : SPlan.Plan}:
  {==}

def pl_no_expiry_means_fetch() -> {SPlan.plan_for("{\"claudeAiOauth\": {\"accessToken\": \"tok\"}}", 1000) == SPlan.PFetch{"tok"} : SPlan.Plan}:
  {==}

def pl_no_token() -> {SPlan.plan_for("{\"claudeAiOauth\": {}}", 1000) == SPlan.PSkip{"no access token to resolve"} : SPlan.Plan}:
  {==}

def pl_not_json() -> {SPlan.plan_for("sk-ant-api03-x", 1000) == SPlan.PSkip{"no access token to resolve"} : SPlan.Plan}:
  {==}

def notice() -> {Store.notice_text("a@b.test", "why") == "Notice: could not verify that the stored credential belongs to a@b.test (why). Registering anyway; re-run where the check can complete to confirm.\n" : String}:
  {==}

# ---- reading curl's output ----

def raw() -> String:
  "HTTP/2 200\r\ncontent-type: application/json\r\n\r\n{\"a\": 1}\n200"

def h_status() -> {Http.status(raw()) == 200 : U32}:
  {==}

def h_body() -> {Http.body(raw()) == "{\"a\": 1}" : String}:
  {==}

def h_status_403() -> {Http.status("HTTP/2 403\r\n\r\n\n403") == 403 : U32}:
  {==}

def h_status_missing() -> {Http.status("") == 0 : U32}:
  {==}

